# Copy to .env.local. Replace CHANGE_ME locally; never commit real credentials.
POSTGRES_DB=self_lab
POSTGRES_USER=self_lab
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://self_lab:CHANGE_ME@127.0.0.1:5432/self_lab
TEST_DATABASE_URL=postgresql://self_lab:CHANGE_ME@127.0.0.1:5433/self_lab_test
# For a managed database, run migrations separately with its direct TLS URL:
# MIGRATION_DATABASE_URL=postgresql://USER:CHANGE_ME@DIRECT_HOST/DATABASE?sslmode=verify-full
# Generate a separate high-entropy secret locally (at least 32 characters).
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3000
# Local Mailpit only. Leave SMTP_HOST/SMTP_PORT unset in production until Stage 9B.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
