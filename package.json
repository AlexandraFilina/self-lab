{
  "name": "habit-experiments",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "node --conditions=react-server --import tsx --test tests/browser/*.test.ts",
    "test:browser:dev": "SELF_LAB_TEST_DEV=1 node --conditions=react-server --import tsx --test tests/browser/*.test.ts",
    "db:generate": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db-migrate.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/db-seed.ts",
    "db:status": "node --conditions=react-server --import tsx scripts/db-status.ts",
    "test:db": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "test:auth": "node --conditions=react-server --import tsx --test tests/integration/auth.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.8",
    "@radix-ui/react-slot": "^1.5.0",
    "better-auth": "^1.7.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
